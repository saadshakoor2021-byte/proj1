# UniPath Pakistan - Environment Configuration
# Copy this file to `.env` for local development. Never prefix secrets with VITE_.
# Browser code cannot read these values; the Vite server plugin uses them.

# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Nebius Token Factory Configuration
# NEBIUS_API_KEY=your_nebius_api_key_here
# NEBIUS_ENDPOINT=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Optional production database (not used by this prototype)
# DATABASE_URL=postgresql://user:password@localhost:5432/unipath
